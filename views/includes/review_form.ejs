<link rel="stylesheet" href="/review_form.css">
<section class="review-section">

    <div class="review-heading">
        <span class="review-heading-icon">✎</span>
        <h2>Leave a Review</h2>
    </div>

    <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        class="review-form"
    >

        <!-- Rating -->
        <div class="form-group">

            <label class="review-label">
                Your Rating
            </label>

            <div class="rating-wrapper">

                <div class="star-rating">

                    <input
                        type="radio"
                        id="star5"
                        name="review[rating]"
                        value="5"
                    >
                    <label for="star5">★</label>


                    <input
                        type="radio"
                        id="star4"
                        name="review[rating]"
                        value="4"
                    >
                    <label for="star4">★</label>


                    <input
                        type="radio"
                        id="star3"
                        name="review[rating]"
                        value="3"
                    >
                    <label for="star3">★</label>


                    <input
                        type="radio"
                        id="star2"
                        name="review[rating]"
                        value="2"
                    >
                    <label for="star2">★</label>


                    <input
                        type="radio"
                        id="star1"
                        name="review[rating]"
                        value="1"
                    >
                    <label for="star1">★</label>

                </div>

                <span class="rating-text">
                    Select a rating
                </span>

            </div>

        </div>


        <!-- Comment -->
        <div class="form-group">

            <label
                for="comment"
                class="review-label"
            >
                Your Comment
            </label>

            <textarea
                id="comment"
                name="review[comment]"
                class="review-textarea"
                placeholder="Share your experience — what did you like or dislike? (min 5 characters)"
                minlength="5"
                required
            ></textarea>

        </div>


        <!-- Submit -->
        <button
            type="submit"
            class="review-submit"
        >
            ➤ Submit Review
        </button>

    </form>

</section>