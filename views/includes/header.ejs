<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title || "MandalGo" %></title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">

        <div class="nav-container">

            <!-- Logo -->
            <a href="/listings" class="logo">
                <img
                    src="/images/mg-new-logo.png"
                    alt="MandalGo"
                >
            </a>
            <!-- Search -->
        <form action="/listings" method="GET" class="search-form">

            <input
                type="text"
                name="search"
                placeholder="Search destinations..."
                autocomplete="off"
            >

            <button type="submit" class="search-btn">
                🔍
            </button>

        </form>
            <!-- Navigation -->
            <div class="nav-links">

                <a href="#listings">
                    Explore
                </a>

                <a href="/listings/new" class="add-btn">
                    + Add Listing
                </a>

            </div>

        </div>

    </nav>