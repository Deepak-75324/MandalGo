<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Forgot Password | MandalGo</title>
    <link rel="stylesheet" href="/signup-login.css">

</head>

<body>

    <div class="forgot-container">

        <div class="logo">
            <img
                src="/images/mg-new-logo.png"
                alt="MandalGo"
            >
        </div>

        <h1 class="forgot-title">
            Forgot Password?
        </h1>

        <p class="forgot-subtitle">
            Enter your registered email and we'll send you an OTP
            to reset your password.
        </p>

        <form
            action="/forgot-password"
            method="POST"
        >

            <div class="form-group">

                <label for="email">
                    Email Address
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your registered email"
                    autocomplete="email"
                    required
                >

            </div>

            <button
                type="submit"
                class="send-otp-btn"
            >
                Send OTP
            </button>

        </form>

        <a
            href="/login"
            class="back-login"
        >
            ← Back to Login
        </a>

        <p class="footer-text">
            Explore Anywhere. Discover Places. Plan Your Journey.
        </p>

    </div>

</body>

</html>